#!/bin/bash
# Foundry pre-commit: run the deterministic linter on staged vault notes (spec §6.9).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
lint="$root/system/scripts/lint_vault.sh"
pattern='^(wiki/|briefings/|raw/telemetry/|raw/(work|personal|shared)/|system/schemas/|system/agents/|system/config|system/codebases/)'
# Safely handle staged filenames with spaces and non-ASCII characters using -z.
mapfile -d '' -t staged < <(git diff --cached --name-only -z --diff-filter=ACMR)
# Conflict markers never land (two-machine spec §5.5): any staged file with a "<<<<<<< " line and a later
# ">>>>>>> " line. "=======" is valid Markdown (a setext underline), so it is never looked at.
markers=0
for f in "${staged[@]}"; do
  if LC_ALL=C awk '/^<<<<<<< / { s = 1 } s && /^>>>>>>> / { m = 1; exit } END { exit !m }' < <(git cat-file blob ":$f" 2>/dev/null); then
    echo "pre-commit: conflict markers in $f; resolve them before committing" >&2
    markers=1
  fi
done
(( markers == 0 )) || exit 1
# Meeting drops (meetings spec §2.2; audit S6 spec §2): transcripts only, and each staged one is rewritten through
# the import's Drive-link stripping and full redaction (redact.py --drop decodes UTF-8 or UTF-16 as the import does)
# in the working file and the index, so the pushed blob holds nothing the published transcript does not. A drop that
# does not decode (NULs in the text) is refused with the import's reason, and so is a symlink or a partly staged file
# (the rewrite would follow the link or drop the unstaged text); a file is only ever overwritten with a successful result.
drops=0
tmp="$(mktemp)" err="$(mktemp)"
trap 'rm -f "$tmp" "$err"' EXIT
for f in "${staged[@]}"; do
  [[ "$f" == meetings/drop/* ]] || continue
  case "${f,,}" in
    */.gitkeep) continue ;;
    *.vtt|*.srt|*.txt|*.md) ;;
    *) echo "pre-commit: $f is not a transcript (.vtt, .srt, .txt or .md); remove it from meetings/drop/" >&2
       drops=1
       continue ;;
  esac
  if [[ -L "$root/$f" || ! -f "$root/$f" ]]; then
    echo "pre-commit: $f is not a regular file; remove it from meetings/drop/" >&2
    drops=1
    continue
  fi
  if ! git diff --quiet -- "$root/$f"; then
    echo "pre-commit: $f has unstaged changes; stage the whole file (git add $f)" >&2
    drops=1
    continue
  fi
  rc=0
  git cat-file blob ":$f" | python3 "$root/system/scripts/redact.py" --drop > "$tmp" 2> "$err" || rc=$?
  if (( rc != 0 )); then
    reason="$(cat "$err")"
    [[ "$reason" != redact:* ]] || reason="${reason#redact: }; remove it from meetings/drop/"
    echo "pre-commit: $f: $reason" >&2
    drops=1
    continue
  fi
  cat "$tmp" > "$root/$f"
  git add -- "$root/$f"
  n="$(sed -n 's/^redactions: //p' "$err")"
  (( ${n:-0} == 0 )) || echo "pre-commit: redacted $n in $f"
done
rm -f "$tmp" "$err"
(( drops == 0 )) || exit 1
found=0
for f in "${staged[@]}"; do
  if [[ $f =~ $pattern ]]; then
    found=1
    break
  fi
done
if [[ $found -eq 0 ]]; then
  exit 0
fi
if [[ ! -x "$lint" ]]; then
  echo "pre-commit: $lint is missing or not executable" >&2
  exit 1
fi
exec "$lint" --staged
