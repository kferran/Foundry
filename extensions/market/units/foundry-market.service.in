[Unit]
Description=The Foundry: market watch fetch and rating

[Service]
Type=oneshot
WorkingDirectory={{VAULT_ROOT}}
Environment="TZ={{TZ}}"
Environment="PATH={{UNIT_PATH}}"
Environment="CLAUDE_BIN={{CLAUDE_BIN}}"
TimeoutStartSec=50min
SuccessExitStatus=1
ExecStart="{{VAULT_ROOT}}/extensions/market/scripts/market_unit.py"
