#!/bin/bash
# Test double for the watch's claude calls. `mcp list` prints STUB_MCP_LIST. A session is told apart by its one
# allowed tool: the Slack search prints STUB_SLACK_STREAM, the Gmail search STUB_MAIL_STREAM and the calendar's
# list_events STUB_CAL_STREAM (each skipped with an empty result when unset); its argv goes to STUB_ARGS_<kind>.
if [[ "${1:-}" == mcp && "${2:-}" == list ]]; then
  printf '%s\n' "Checking MCP server health…" "" "${STUB_MCP_LIST:-}"
  exit 0
fi
prev="" kind=""
for a in "$@"; do
  if [[ "$prev" == --allowedTools ]]; then
    case "$a" in
      *__slack_search_public_and_private) kind=SLACK ;;
      *Gmail__search_threads) kind=MAIL ;;
      *Calendar__list_events) kind=CAL ;;
    esac
  fi
  prev="$a"
done
args="STUB_ARGS_$kind" stream="STUB_${kind}_STREAM"
printf '%s\n' "$@" > "${!args:-/dev/null}"
if [[ -n "${!stream:-}" ]]; then
  cat "${!stream}"
else
  printf '{"type":"result","subtype":"success","is_error":false,"result":"{}"}\n'
fi
