[Unit]
Description=The Foundry: intraday watch (channels, calendar, commitments, capture)

[Service]
Type=oneshot
WorkingDirectory={{VAULT_ROOT}}
Environment="TZ={{TZ}}"
Environment="PATH={{UNIT_PATH}}"
TimeoutStartSec=25min
SuccessExitStatus=1 4
ExecStart="{{VAULT_ROOT}}/extensions/intraday/scripts/watch_fetch.sh"
