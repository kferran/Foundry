[Unit]
Description=Second Brain: Chief of Staff evening debrief

[Service]
Type=oneshot
WorkingDirectory=/home/fe/Work/Jarvis
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env claude -p "/debrief"
StandardOutput=append:/home/fe/Work/Jarvis/system/logs/debrief.log
StandardError=append:/home/fe/Work/Jarvis/system/logs/debrief.log
