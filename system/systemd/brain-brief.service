[Unit]
Description=Second Brain: Chief of Staff morning brief

[Service]
Type=oneshot
WorkingDirectory=/home/fe/Work/Jarvis
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env claude -p "/brief"
StandardOutput=append:/home/fe/Work/Jarvis/system/logs/brief.log
StandardError=append:/home/fe/Work/Jarvis/system/logs/brief.log
